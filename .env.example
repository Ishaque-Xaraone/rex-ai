# Environment Configuration Template for REX AI Platform
# Copy this file to .env before starting services

# Application Environment (development | production | test)
NODE_ENV=development

# Backend Service
PORT=4000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=rex_user
DB_PASSWORD=rex_secure_password_placeholder
DB_NAME=rex_ai
DB_SSL=false
# Optional full connection URL (overrides discrete DB_* settings when set)
# DATABASE_URL=postgresql://rex_user:rex_secure_password_placeholder@localhost:5432/rex_ai

# Storage & Security Quotas
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_BYTES=52428800     # 50 MB
MAX_EXPANDED_SIZE_BYTES=209715200  # 200 MB
MAX_FILE_COUNT=1000                # Max file count in archive

# AI Service (FastAPI)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=30000

# AI Provider API Keys (Leave blank to use built-in deterministic verification provider)
DEFAULT_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000/api
